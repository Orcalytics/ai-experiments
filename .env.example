# Copy to .env in the repository root. Never commit the real key.
OPENAI_API_KEY=

# Optional override. Empty keeps the original experiment defaults:
# industry/vector: gpt-5.1; other experiments: gpt-5-mini.
OPENAI_MODEL=

# Create these explicitly with `orcalytics prepare-store`, then reuse their IDs.
INDUSTRY_VECTOR_STORE_ID=
EVENT_VECTOR_STORE_ID=
